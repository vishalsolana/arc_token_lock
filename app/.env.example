# WalletConnect Cloud project ID (required by RainbowKit) — get one free at cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Overrides the default RPC URLs in lib/chains.ts, if you use a different provider than Circle's
# own. Testnet chain ID (5042002) and RPC (rpc.testnet.arc.io) are confirmed from docs.arc.io.
# Mainnet (chain 5042) launches September 16, 2026 — its real RPC isn't published yet.
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=

# TokenLocker addresses after each deploy (see ../contracts/README.md)
NEXT_PUBLIC_TOKEN_LOCKER_ADDRESS_TESTNET=
NEXT_PUBLIC_TOKEN_LOCKER_ADDRESS_MAINNET=

# Optional — shown on the homepage once set (blank hides them entirely, no code change needed
# either way, just set these in Vercel's env vars and redeploy when you have real values):
NEXT_PUBLIC_PROJECT_CA=
NEXT_PUBLIC_PROJECT_TICKER=
NEXT_PUBLIC_X_URL=

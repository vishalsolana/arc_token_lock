# WalletConnect Cloud project ID (required by RainbowKit) — get one free at cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arc mainnet RPC URL. Chain ID (5042) and native currency (USDC) are set in lib/chains.ts —
# double check both against Arc's official docs before going live, they came from a chat message,
# not verified docs.
NEXT_PUBLIC_ARC_RPC_URL=

# TokenLocker address after deploy (see ../contracts/README.md)
NEXT_PUBLIC_TOKEN_LOCKER_ADDRESS=
